    omegaNF_shape152 (show lt M (add (Z zero) Y) = false from ltF_M_addOm135 Y _) rfl
      (isFP_add152 _ _) (dnArg_of_split162 hsplit)⟩
  · show lt (add (Z zero) Y) (reg 1) = false
