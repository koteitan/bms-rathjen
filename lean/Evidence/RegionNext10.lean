  | succ pp => exact not_ksetStepOK_famG_hi_k174 h1m (by omega) h3 hk

theorem not_ksetStepOK_famG_j174 {m p k j : Nat} (h1m : 1 ≤ m) (hpk : 1 ≤ p ∨ 1 ≤ k)
    (h3 : 3 ≤ m + p) (hj : m + p < j) : ¬ KsetStepOK 0 (dict (famG158 m p k j)) := by
  cases p with
  | zero =>
