/-- **併合した桁の指数、頭が `TW (c+2)`。** -/
theorem idxmrg_hi177 {Y C : Term} {c : Nat} (hY : Tl167 Y C)
    (hb : BaseOK162 (add (TW (c + 2)) Y))
    (hplus : plus (TW (c + 2)) Y = add (TW (c + 2)) Y)
    (hleoneC : le TM.Term.one C = true) :
