/-- **`m < k` の `U` は `K` 標準でない** — 本数 `n` に依らない。 -/
theorem not_std_famU176 {m k n : Nat} (hmk : m < k) :
    BT.isStd (BT.D 0 (famU176 m k n)) = false := by
