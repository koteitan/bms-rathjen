  have h := stepOK_iff_US178 (seedOK_famR178 hok) (idxHead_famR178 hok)
    (dict_seedR178 hok) q0
  constructor
  · intro H
    have := h.mp H
    omega
  · intro H
    exact h.mpr (by omega)

theorem ksetStepOK_famUR178 {hh q m : Nat} {rs : RL178}
    (hok : RunsOK178 (hh + 4) q rs) (h3m : 3 ≤ m) (hle : hh + 4 ≤ m) :
