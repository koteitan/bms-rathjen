theorem famVR1G_no_refute178 {hh q m : Nat} {rs : RL178}
    (hd : DescRL178 ((hh + 4, q) :: rs)) (h2m : 2 ≤ m)
    (hs : BT.isStd (BT.D 0 (famVR178 m 1 ((hh + 4, q) :: rs))) = true) :
