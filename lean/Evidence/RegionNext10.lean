      rw [Trans.Dict.dict_sum, Trans.Dict.dict_sum, dict_bT152 a,
        show dict (BT.D 0 (nst132 k BT.zero)) = sd152 k from rfl,
        show dict (BT.D 0 (nst132 0 BT.zero)) = TM.Term.one from sd0_152,
