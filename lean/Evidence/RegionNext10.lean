        lt_phiPsi_reg1_156 (by decide) _,
        lt_phiPsi_reg2_156 (by decide) _, ?_⟩
      intro y hy
      replace hy : y ∈ Kset (reg 1) (psi (Z zero) (UW152 (Z zero) (kk + 2))) := hy
      rw [Kset_psi_reg152, Kset_UW152] at hy
