                          exact lt_self_plus109 (inT_wC hip) (isAP_omegaNF _) hiac2 hnz2
                        · have hP2 : (wcnf (reg 1) (p :: t2)).1
                              = (wA (reg 1) p, wC (reg 1) p) :: ac2 :: ps2 := by
                            rw [wcnf_cons_ge hpw, hr2]
