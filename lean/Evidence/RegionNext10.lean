theorem sd_sdR176 (k : Nat) : sdR176 k 0 = sd152 (k + 4) := (sd_psi152 k).symm

theorem dict_seed176 (k n : Nat) :
    dict (BT.D 0 (brep176 n (nst132 (k + 4) BT.zero))) = sdR176 k n := by
  show collapse 0 (dict (brep176 n (nst132 (k + 2 + 2) BT.zero)))
