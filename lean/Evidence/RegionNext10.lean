                              = (wA (reg 1) p, wC (reg 1) p) :: x :: tx := by
                            rw [wcnf_cons_ge hpw, hr1]
                            show ((if (wA (reg 1) p == x.1) = true
                                then ((wA (reg 1) p, plus (wC (reg 1) p) x.2) :: tx, snd1)
