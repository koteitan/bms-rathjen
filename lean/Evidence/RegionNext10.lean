theorem ksetStepOK_famG174 {m p k j : Nat} (h1m : 1 ≤ m) (hpk : 1 ≤ p ∨ 1 ≤ k)
    (hk : k ≤ m + p) (hj : j ≤ m + p) : KsetStepOK 0 (dict (famG158 m p k j)) := by
