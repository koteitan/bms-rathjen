theorem firstFire_famJ162 (m p k j : Nat) (h2m : 2 ≤ m) (h2p : 2 ≤ p) (h3k : 3 ≤ k)
    (h1j : 1 ≤ j) (hjk : j ≤ k) (hkmp : k ≤ m + p) : FirstFire145 (famJ162 m p k j) :=
