  · exact ksetStepOK_famI1_0_168 h h1k hkm

/-- **§168 の類 (a) の `p = 1`, `j = 0`、広げた窓 — `2 ≤ m` を `1 ≤ m` に。** -/
theorem ksetStepOK_famJ1_0_wide171 {m k : Nat} (h1m : 1 ≤ m) (h3k : 3 ≤ k)
    (hkm : k ≤ m + 1) : KsetStepOK 0 (dict (famJ162 m 1 k 0)) := by
