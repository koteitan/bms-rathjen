          && (BT.GB 0 (famU176 m k n)).all (fun e => BT.lt e (famU176 m k n))) = true := hs
      have h2 := List.all_eq_true.mp ((Bool.and_eq_true _ _).mp h0).2 _
        (mem_GB_famU176 m k n)
