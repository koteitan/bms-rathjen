theorem dict_famK1_j0_170 (b : Nat) : ∀ m : Nat,
    dict (famK162 (m + 1) 1 (b + 3) 0)
      = UW152 (psi (Z zero) (PT162 (WB162 (b + 1) TM.Term.one) 0)) m :=
