    sub1_PT162 hb 0]

theorem stepOK_PT0_hi167 {Y C : Term} {c : Nat} (hY : Tl167 Y C)
    (hb : BaseOK162 (add (TW (c + 2)) Y))
    (hplus : plus (TW (c + 2)) Y = add (TW (c + 2)) Y)
