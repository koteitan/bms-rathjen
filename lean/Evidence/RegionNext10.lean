                              then ((wA (reg 1) p, plus (wC (reg 1) p) y.2) :: ty, snd2)
                              else ((wA (reg 1) p, wC (reg 1) p) :: (y.1, y.2)
                                    :: ty, snd2)) : List (Term × Term) × Term).1 = _
                          rw [if_pos hmy]
