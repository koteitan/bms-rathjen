    (dict_seedK1_j0_170 b)

theorem dict_famK1_p2_j0_170 : ∀ m : Nat,
    dict (famK162 (m + 1) 1 2 0) = UW152 (psi (Z zero) (phi zero TM.Term.one)) m :=
