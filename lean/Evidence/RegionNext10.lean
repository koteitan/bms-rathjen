                          show ((if (wA (reg 1) p == x.1) = true
                              then ((wA (reg 1) p, plus (wC (reg 1) p) x.2) :: tx, snd1)
                              else ((wA (reg 1) p, wC (reg 1) p) :: (x.1, x.2)
                                    :: tx, snd1)) : List (Term × Term) × Term).1 = _
                          rw [if_neg hmx]
