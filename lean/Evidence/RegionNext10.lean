    show toList (add (TW (c + 2)) Y) = TW (c + 2) :: toList Y from rfl,
    filter_ge_keep167 (lt_TW_reg1_162 (c + 1)), hY.hge]
  show ofList [divAP (reg 1) (TW (c + 2))] = _
