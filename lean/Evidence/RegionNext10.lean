/-- **中の塔の閉じた形** (§158 の `famF158` の形、`§162` の言葉で)。 -/
theorem dict_famF162 {a j : Nat} (h1j : 1 ≤ j) : ∀ k : Nat,
    dict (nst132 (k + 1) (BT.sum (nst132 (a + 2) BT.zero) (BT.D 0 (nst132 j BT.zero))))
      = PT162 (WB162 a (sd152 j)) k
  | 0 => by
