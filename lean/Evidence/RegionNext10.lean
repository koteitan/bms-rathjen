    狭義降順の走りの並びをぜんぶ作る。 -/

def rlAll178 : Nat → Nat → List RL178
  | _, 0 => [[]]
  | hi, n + 1 =>
      ((List.range (hi + 1)).filter (fun h => decide (1 ≤ h))).flatMap fun h =>
        (List.range 2).flatMap fun q =>
          (rlAll178 (h - 1) n).map (fun rs => (h, q) :: rs)

