/-! ### §168.2 Class (b) at `j = 0`: base `TW(a+1) ⊕ sd_k ⊕ 1` -/

theorem toList_IB0_168 (s : Term) (a : Nat) :
    toList (WB162 a (add s TM.Term.one)) = [TW (a + 1), s, TM.Term.one] := rfl

theorem ofList_IB0_168 (s : Term) (a : Nat) :
