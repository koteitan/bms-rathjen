  obtain ⟨hiT, hTW, hTap, hTE⟩ := hstE T hT2
  have h1T : lt TM.Term.one T = true :=
    lt_of_lt_of_le3 (show FragR TM.Term.one = true from rfl) (inT_le_fragR _ inT_E81)
