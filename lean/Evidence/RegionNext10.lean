  show (if ((PT162 (add (TW (c + 2)) Y) 0 : Term) == TM.Term.one) = true
        then ofList (toList (TW (c + 3)))
        else add (PT162 (add (TW (c + 2)) Y) 0) (TW (c + 3))) = _
  rw [if_neg (by rw [beq_PT_one162 hb 0]; exact Bool.noConfusion)]

