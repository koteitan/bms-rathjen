/-- The value of a prefix is a `𝔗(M)` term below `Ω₁`. -/
theorem wVal_dict_facts160 (Hp : PsiIdxOKStd172) {a : BT}
    (hb : btLe72 1 (BT.D 0 a) = true) (hs : BT.isStd (BT.D 0 a) = true)
