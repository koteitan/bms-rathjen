theorem not_ksetStepOK_famG_k174 {m p k j : Nat} (h1m : 1 ≤ m) (hpk : 1 ≤ p ∨ 1 ≤ k)
    (h3 : 3 ≤ m + p) (hk : m + p < k) : ¬ KsetStepOK 0 (dict (famG158 m p k j)) := by
  cases p with
